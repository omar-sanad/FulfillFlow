# FulfillFlow local development environment example.
# Copy this file to `.env` and adjust as needed.
# NEVER commit your real `.env` file. All values here are development-only and
# synthetic. No real credentials are used anywhere in this project.

# ----------------------------------------------------------------------------
# PostgreSQL (shared host, one logical database per service)
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=fulfillflow-dev

# Per-service databases and credentials (each service owns its data)
ORDER_DB_NAME=fulfillflow_order
ORDER_DB_USER=order_service
ORDER_DB_PASSWORD=order-dev-password

INVENTORY_DB_NAME=fulfillflow_inventory
INVENTORY_DB_USER=inventory_service
INVENTORY_DB_PASSWORD=inventory-dev-password

DELIVERY_DB_NAME=fulfillflow_delivery
DELIVERY_DB_USER=delivery_service
DELIVERY_DB_PASSWORD=delivery-dev-password

NOTIFICATION_DB_NAME=fulfillflow_notification
NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=notification-dev-password

# ----------------------------------------------------------------------------
# Apache Kafka (KRaft mode)
# ----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_INTERNAL_BOOTSTRAP=kafka:9092

# ----------------------------------------------------------------------------
# Keycloak (OAuth2 / OIDC)
# ----------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=fulfillflow
KEYCLOAK_REALM_PUBLIC_KEY=
# Development-only client secrets. Replace in your local .env; do not commit
# production secrets. The frontend uses public PKCE clients (no secret).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password

# ----------------------------------------------------------------------------
# Backend services
# ----------------------------------------------------------------------------
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
DELIVERY_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# JWT issuer used by resource servers to validate access tokens
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8081
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=fulfillflow
VITE_KEYCLOAK_CLIENT_ID=fulfillflow-frontend

# ----------------------------------------------------------------------------
# Observability (monitoring profile)
# ----------------------------------------------------------------------------
PROMETHEUS_PORT=9095
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ----------------------------------------------------------------------------
# Demonstration users (synthetic). Seeded by the identity milestone.
# Listed here for local development convenience only.
# ----------------------------------------------------------------------------
# DEMO_CUSTOMER_USER=customer
# DEMO_CUSTOMER_PASSWORD=customer-dev
# DEMO_ADMIN_USER=administrator
# DEMO_ADMIN_PASSWORD=admin-dev
# DEMO_WAREHOUSE_USER=warehouse
# DEMO_WAREHOUSE_PASSWORD=warehouse-dev
# DEMO_COURIER_USER=courier
# DEMO_COURIER_PASSWORD=courier-dev
